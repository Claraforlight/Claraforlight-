# ====================================================================
#  Configuration du Setter Claude — copiez ce fichier en ".env"
#  et remplissez chaque valeur. Ne partagez JAMAIS le .env rempli.
# ====================================================================

# --- Serveur ---
PORT=3000

# --- Meta / Instagram (voir README, etapes 1 a 4) ---
# Jeton "verify token" : une phrase secrete que VOUS inventez.
# Vous la retaperez a l'identique dans la config du webhook Meta.
META_VERIFY_TOKEN=inventez-une-phrase-secrete-ici

# Jeton d'acces de la Page (Page Access Token), genere dans l'app Meta.
META_PAGE_ACCESS_TOKEN=

# Secret de l'app Meta (App Secret) — sert a verifier la signature des
# webhooks pour etre sur qu'ils viennent bien de Meta.
META_APP_SECRET=

# L'ID de votre compte Instagram Pro (Instagram Business Account ID).
# Sert a ignorer les messages que le bot s'envoie a lui-meme.
IG_BUSINESS_ID=

# --- Claude (console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=

# Modele Claude. claude-opus-5 = qualite maximale.
# Pour reduire les couts sur gros volume : claude-sonnet-5.
CLAUDE_MODEL=claude-opus-5

# --- Prise de rendez-vous ---
# Votre lien de reservation (Calendly, Cal.com, etc.).
# Claude le proposera quand un prospect est qualifie et chaud.
BOOKING_LINK=https://calendly.com/votre-lien

# --- Securite / garde-fous ---
# Mots-cles qui declenchent une remise en main humaine (le bot se tait
# et vous notifie dans les logs). Separez par des virgules.
HANDOFF_KEYWORDS=humain,parler a quelqu'un,remboursement,avocat,plainte
